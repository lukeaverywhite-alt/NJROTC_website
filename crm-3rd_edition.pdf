   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">160526-N-UN744-011</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>fwny2016</rdf:li>
     <rdf:li>CNRC</rdf:li>
     <rdf:li>Navy Recruiting New York</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Public Domain</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">OLD WESTBURY, New York (May 26, 2016) Rear Adm. Jeffrey W. Hughes, commander of Navy Recruiting Command, answers questions from members of the Westbury High School Navy Junior Reserve Officer Training Corps during a visit to the shool. Hughes discussed the role of the Navy with the students and then headed out to the school grounds for a #FleetWeekNYC aerial demonstration consisting of fast-roping, EOD demonstrations and helicopter tours. Fleet Week New York, now in its 28th year, is the city's time-honored celebration of the sea services. It is an unparalleled opportunity for the citizens of New York and the surrounding tri-state area to meet Sailors, Marines and Coast Guardsmen, as well as witness firsthand the latest capabilities of today's maritime services. (U.S. Navy photo by Chief Mass Communication Specialist Travis Simmons/Released)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Chief Petty Officer Travis Simmo</rdf:li>
    </rdf:Seq>
   </dc:creator>
