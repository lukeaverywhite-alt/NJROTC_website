   <dc:subject>
    <rdf:Bag>
     <rdf:li>POW MIA Recognition Day</rdf:li>
     <rdf:li>Nile C. Kinnick High School NJROTC</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Petty Officer 2nd Class Greg Mitchell</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Public Domain</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Nile C. Kinnick High School Navy Jr. Reserve Officers' Training Corps(NJROTC) Cadet Commanding Officer, Ltjg. Timothy Kohatsu leads the JROTC color guard in rendering honors dedicated to America's prisoners of war and missing in action during a Recognition Day ceremony honorably commemorating those who served their country at Commander, Fleet Activities Yokosuka. (US Navy photo by Greg Mitchell, CFAY Public Affairs)</rdf:li>
    </rdf:Alt>
   </dc:description>
