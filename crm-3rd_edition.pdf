   <dc:subject>
    <rdf:Bag>
     <rdf:li>Electronics Technician 2nd Class Jeffrey Thomas</rdf:li>
     <rdf:li>from Navy Recruiting Orientation Unit (NORU) Pensacola</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:rights>
