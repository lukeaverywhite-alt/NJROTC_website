# Copy to .env on the server and replace every CHANGE_ME value. Never commit .env.
PUBLIC_ORIGIN=https://njrotc.example.org
SESSION_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=CHANGE_ME_INDEPENDENT_64_RANDOM_CHARACTERS
DATABASE_PATH=/data/site.sqlite3
MEDIA_DIR=/media
OWNER_EMAIL=CHANGE_ME
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_SENDER=CHANGE_ME
TRUSTED_PROXIES=127.0.0.1,::1
SECURE_COOKIES=1
RESTIC_REPOSITORY=CHANGE_ME
RESTIC_PASSWORD=CHANGE_ME
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
